{"manifest_version":3,"name":"CheckMate","version":"1.0","description":"Attendance, activity and engagement tracking for Google Meet classes.",
"icons":{"48":"icon.png"},
"permissions":["storage","tabs","alarms","notifications"],
"host_permissions":["https://meet.google.com/*","https://script.google.com/*","https://script.googleusercontent.com/*"],
"background":{"service_worker":"background.js"},
"content_scripts":[{"matches":["https://meet.google.com/*-*-*"],"js":["config.js","content.js"],"run_at":"document_idle"}],
"action":{"default_popup":"popup.html"}}
